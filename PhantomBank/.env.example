# Generated local runtime values are written by ./scripts/setup.sh. Never commit .env.
POSTGRES_USER=phantombank
POSTGRES_PASSWORD=replace-with-a-local-random-password
REAL_POSTGRES_DB=phantombank_real
HONEYPOT_POSTGRES_DB=phantombank_honeypot
AUTH_SECRET_KEY=replace-with-a-local-random-secret
DEFENDER_EVIDENCE_TOKEN=replace-with-a-local-random-token
BACKEND_PORT=8001
FRONTEND_PORT=3001
COOKIE_SECURE=false
DEMO_MODE=true
PROTECTION_MODE=standalone
DOMAIN_VERIFICATION_TOKEN=
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Parent PhantomLayer registration values. Setup or the parent deployment writes these.
PHANTOMLAYER_URL=http://backend:8000
AGENT_ID=
AGENT_TOKEN=
